// Nguồn sự thật cho database. Mọi thay đổi schema phải đi kèm migration (xem CONTRIBUTING.md).
generator client {
  provider   = "prisma-client-js"
  engineType = "client" // không dùng engine Rust; chạy qua driver adapter (@prisma/adapter-pg)
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())

  bankAccount  BankAccount?
  memberships  GroupMember[]
  paidExpenses Expense[]      @relation("PaidBy")
  splits       ExpenseSplit[]
  settlementsFrom Settlement[] @relation("SettlementFrom")
  settlementsTo   Settlement[] @relation("SettlementTo")
}

model BankAccount {
  id            String @id @default(cuid())
  userId        String @unique
  bankBin       String
  accountNumber String
  accountHolder String
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Group {
  id          String   @id @default(cuid())
  name        String
  createdById String
  createdAt   DateTime @default(now())

  members     GroupMember[]
  expenses    Expense[]
  settlements Settlement[]
}

model GroupMember {
  groupId  String
  userId   String
  joinedAt DateTime @default(now())
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
}

model Expense {
  id           String   @id @default(cuid())
  groupId      String
  paidById     String
  description  String
  amount       Int // VND, số nguyên
  billImageUrl String?
  createdAt    DateTime @default(now())

  group  Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidBy User           @relation("PaidBy", fields: [paidById], references: [id])
  splits ExpenseSplit[]

  @@index([groupId])
}

model ExpenseSplit {
  id        String  @id @default(cuid())
  expenseId String
  userId    String
  amount    Int
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id])

  @@index([expenseId])
}

model Settlement {
  id         String   @id @default(cuid())
  groupId    String
  fromUserId String
  toUserId   String
  amount     Int
  createdAt  DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  from  User  @relation("SettlementFrom", fields: [fromUserId], references: [id])
  to    User  @relation("SettlementTo", fields: [toUserId], references: [id])

  @@index([groupId])
}
